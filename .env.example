# Firebase web-app config (Firebase Console → Project settings → Your apps → Web app → SDK setup and configuration → Config).
# Copy to .env.local (git-ignored) and fill in. These values are public identifiers, not secrets;
# access is enforced by firestore.rules. Restart `npx expo start` after editing.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
