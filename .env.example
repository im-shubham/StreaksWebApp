# Firebase web-app config (Firebase Console → Project settings → Your apps → Web app → SDK setup and configuration → Config).
# The project's real values are committed in .env. To point at another Firebase project, copy this to .env.local (git-ignored) and fill it in. These values are public identifiers, not secrets;
# access is enforced by firestore.rules. Restart `npx expo start` after editing.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In (docs/setup/google-sign-in.md). Needs a development build; not available in Expo Go.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Momentum Pro paywall legal links (docs/setup/billing.md). Required by Apple for subscriptions.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
